# Block direct web access to secrets and local data files.
# App reads these via PHP; they must never be served directly.

<FilesMatch "^(\.env|data\.php|auth_tokens\.php)$">
    # Apache 2.4+
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    # Apache 2.2 fallback
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block the backups folder (only relevant when DATA_DIR is the app folder).
RedirectMatch 403 ^/backups(/.*)?$

# Belt-and-suspenders: block any leftover dotfiles.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
